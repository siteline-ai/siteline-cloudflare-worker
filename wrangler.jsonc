{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "siteline-cloudflare-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-12-05",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	"dev": {
		"host": "siteline.ai"
	},
	"vars": {
		"SITELINE_API_URL": "https://api.siteline.ai/v1/intake/pageview"
	}
}
